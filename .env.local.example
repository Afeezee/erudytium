# Neon database
# Grab from Neon dashboard → Connection String (use the pooled connection; keep ?sslmode=require)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Pusher Channels (realtime chat, presence, typing, notifications)
# Create a free Channels app at https://dashboard.pusher.com/apps
PUSHER_APP_ID=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Vercel Blob (file storage: avatars, resources, room attachments)
# Create a Blob store in the Vercel dashboard → Storage, then copy the token here.
# Vercel auto-injects it in production; this entry is for local dev.
BLOB_READ_WRITE_TOKEN=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App
NEXT_PUBLIC_APP_URL=
